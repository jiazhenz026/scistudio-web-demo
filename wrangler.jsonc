{
  // Cloudflare Worker + Containers deployment for the SciStudio WebMCP demo.
  //
  // The Worker is the front door: it gates on the demo password and hands each
  // authenticated browser session its own isolated container running SciStudio.
  // An unauthenticated request never starts a container, so the URL cannot be
  // used to spin up compute.
  //
  // Deploy (needs local Docker running; the image builds linux/amd64 and pushes
  // automatically on first deploy):
  //   npm install
  //   npx wrangler secret put DEMO_PASSWORD
  //   npx wrangler deploy
  "name": "scistudio-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "containers": [
    {
      // Builds the repo-root Dockerfile. The container listens on 8000; the
      // Container class below tells the Worker to talk to that port.
      "image": "./Dockerfile",
      "class_name": "SciStudioContainer",
      // Each session holds a private container. Cap the pool so a burst of
      // authenticated users degrades to a wait rather than unbounded spend.
      "max_instances": 20,
      // 4 GiB / half a vCPU — SciStudio idles near 50 MB but a scanpy run on a
      // single-cell matrix wants headroom.
      "instance_type": "standard-1"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "SCISTUDIO",
        "class_name": "SciStudioContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SciStudioContainer"]
    }
  ]
}
